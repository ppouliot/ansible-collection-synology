#influxdb
INFLUXDB_HTTP_AUTH_ENABLED=true
INFLUXDB_ADMIN_USER=unifipoller
INFLUXDB_ADMIN_PASSWORD={{ unifi_poller_influxdb_password }}
INFLUXDB_DB=unpoller
INFLUXDB_ORG=unpoller
INFLUXDB_BUCKET=unpoller
INFLUXDB_ADMIN_TOKEN={{ unifi_poller_influxdb_admin_token }}
INFLUXDB_LOCAL_VOLUME=/volume1/docker/unifi-poller/influxdb


#grafana
GRAFANA_USERNAME=unifipoller
GRAFANA_PASSWORD={{ unifi_poller_grafana_password }}
GRAFANA_LOCAL_USERID={{ user_puid }}
GRAFANA_LOCAL_VOLUME=/volume1/docker/unifi-poller/grafana

#unifi-poller
POLLER_TAG=latest
POLLER_DEBUG=false
POLLER_SAVE_DPI=false
UNIFI_USER={{ unifi_unifipoller_user }}
UNIFI_PASS={{ unifi_unifipoller_user_password }}
UNIFI_URL={{ unifi_cloudkey_url }}
