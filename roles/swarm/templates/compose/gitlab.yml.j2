---
version: '3.5'
services:
  gitlab:
    image: gitlab/gitlab-ce:latest
    volumes:
      - "{{ container_directory_root }}/gitlab/data:/var/opt/gitlab"
      - "{{ container_directory_root }}/gitlab/logs:/var/log/gitlab"
      - "{{ container_directory_root }}/gitlab/config:/etc/gitlab"
    environment:
      GITLAB_OMNIBUS_CONFIG: |
        external_url 'http://Manager-Ip/'
        nginx['listen_port'] = 80
        nginx['listen_https'] = false
        letsencrypt['enable'] = false
    deploy:
      labels:
        - "diun.enable=true"
      placement:
        constraints:
          - node.role == manager

  gitlab-runner:
    image: gitlab/gitlab-runner:alpine
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - "{{ container_directory_root }}/gitlab/runner:/etc/gitlab-runner"
    deploy:
      labels:
        - "diun.enable=true"
      placement:
          - node.role == worker
      mode: replicated
      replicas: 1
      restart_policy:
         condition: any

 # https://github.com/badges/shields/blob/master/doc/self-hosting.md
  shields:
    image: shieldsio/shields:next
    restart: always
    ports:
      - 8080:8080
    volumes:
    enviornment:
      - PORT=8080
    deploy:
      labels:
        - "diun.enable=true"
      placement:
        constraints:
          - node.role == manager

