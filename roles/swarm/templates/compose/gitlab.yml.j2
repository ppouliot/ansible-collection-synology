  atlantis:
    image: ghcr.io/runatlantis/atlantis
    ports:
      - "8080:8080"
    volumes:
      - "{{ container_directory_root }}/atlantis:/var/atlantis
      - "{{ container_directory_root }}/atlantis/.ssh:/home/atlantis/.ssh:ro
    environment:
      ATLANTIS_GH_TOKEN: ${ATLANTIS_GH_TOKEN}
      ATLANTIS_REPO_ALLOWLIST: ${ATLANTIS_REPO_ALLOWLIST}
      ATLANTIS_PORT: 8080
    deploy:
      labels:
        - "diun.enable=true"
      placement:
        constraints: 
          - node.role == manager
  drawio:
    image: jgraph/drawio
    container_name: drawio
    restart: unless-stopped
    ports:
      - 8080:8080
      - 8443:8443
    environment:
      PUBLIC_DNS: domain
      ORGANISATION_UNIT: unit
      ORGANISATION: org
      CITY: city
      STATE: state
      COUNTRY_CODE: country
    deploy:
      labels:
        - "diun.enable=true"
      placement:
        constraints:
          - node.role == worker
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://domain:8080 || exit 1"]
      interval: 1m30s
      timeout: 10s
      retries: 5
      start_period: 10s

  registry:
    image: ghcr.io/project-zot/zot-linux-amd64:latest
    depends_on:
      - gitlab
    volumes:
      - "{{ container_directory_root }}/registry://var/lib/registry
    deploy:
      labels:
        - "diun.enable=true"
      placement:
        constraints:
          - node.role == manager

networks:
  default:
    name: gitlab-network:
    external: true
