---
version: "3.8"
services:
  asciinema:
    image: ghcr.io/asciinema/asciinema-server:20250915
    ports:
      - '4000:4000'
    environment:
      - SECRET_KEY_BASE=  # <- see below
      - URL_HOST=asciinema.example.com
      #- URL_PORT=80
      # Gmail Information
      - SMTP_HOST=smtp.gmail.com
      - SMTP_USERNAME=your-username@gmail.com
      - SMTP_PASSWORD=your-gmail-app-password
    volumes:
      - "{{ container_directory_root }}/asciinema:/var/opt/asciinema"
    depends_on:
      postgres:
        condition: service_healthy
    deploy:
      labels:
        - "diun.enable=true"
      placement:
        constraints:
          - node.role == manager
  postgres:
    image: docker.io/library/postgres:14
    environment:
      - POSTGRES_HOST_AUTH_METHOD=trust
    volumes:
      - "{{ container_directory_root }}/postgresql:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U postgres']
      interval: 2s
      timeout: 5s
      retries: 10
    deploy:
      labels:
        - "diun.enable=true"
      placement:
        constraints:
          - node.role == manager

