---
version: "3.3"
services:
  netbootxyz:
    image: ghcr.io/netbootxyz/netbootxyz
    environment:
      - MENU_VERSION=2.0.84 # optional
      - NGINX_PORT=80 # optional
      - WEB_APP_PORT=3000 # optional
    volumes:
      - "{{ container_directory_root }}/netbootxyz/config:/config"
      - "{{ container_directory_root }}/netbootxyz/assets:/assets"
    ports:
      - 3000:3000  # optional, destination should match ${WEB_APP_PORT} variable above.
      - 69:69/udp
      - 8880:80  # optional, destination should match ${NGINX_PORT} variable above.
    restart: unless-stopped
