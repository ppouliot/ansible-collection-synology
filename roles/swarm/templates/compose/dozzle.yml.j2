---
version: "3.3"
services:
  dozzle:
    image: ghcr.io/amir20/dozzle:latest
    environment:
      - DOZZLE_LEVEL=debug
      - DOZZLE_MODE=swarm
      - DOZZLE_ENABLE_SHELL=true
      - DOZZLE_ENABLE_ACTIONS=true
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - "{{ container_directory_root }}/dozzle:/data"
    ports:
      - 8080:8080
    networks:
     - dozzle
    deploy:
      mode: global
      labels:
        - "diun.enable=true"
networks:
  dozzle:
    driver: overlay
